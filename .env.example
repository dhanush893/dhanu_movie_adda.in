# TMDB API Read Access Token (Bearer token), server-side only
TMDB_ACCESS_TOKEN=your_tmdb_read_access_token

# Optional Watchmode API key for legal streaming availability
WATCHMODE_API_KEY=your_watchmode_api_key

# Admin dashboard credentials (never commit real values)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-long-random-password
ADMIN_SESSION_SECRET=replace-with-a-long-random-random-secret

# Server
PORT=8787
NODE_ENV=development
APP_ORIGIN=http://localhost:5173
